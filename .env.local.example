# Origem liberada para testar localmente
ARTIA_ALLOWED_ORIGINS=http://localhost:3000

# Segredo opcional para proteger o endpoint /api/artia-ids-refresh
ARTIA_REFRESH_SECRET=troque-este-segredo

# Onde o refresh vai buscar os dados: bundled, db ou upstream
ARTIA_IDS_SOURCE_MODE=bundled

# Banco Artia
# Para usar source=db, defina tambem ARTIA_DB_QUERY com aliases:
# project, projectLabel, activity, id
ARTIA_DB_HOST=db.exemplo.com
ARTIA_DB_PORT=3306
ARTIA_DB_USER=cliente-exemplo
ARTIA_DB_PASSWORD=sua-senha-aqui
ARTIA_DB_NAME=banco_exemplo
# ARTIA_DB_SSL=true
# ARTIA_DB_CONNECT_TIMEOUT_MS=10000
# ARTIA_DB_QUERY_TIMEOUT_MS=120000
# Query padrao source=db usa a fonte ampla organization_{org}_activities_v2
# ARTIA_DB_ACTIVITIES_V2_TABLE=organization_123_activities_v2
# Compatibilidade: use ARTIA_DB_QUERY_MODE=active para a consulta filtrada por tabelas ativas
# ARTIA_DB_ACTIVITIES_TABLE=organization_123_activities
# ARTIA_DB_PROJECTS_TABLE=organization_123_projects
# ARTIA_DB_QUERY=SELECT '1360' AS project, 'Cliente X' AS projectLabel, 'Reuniao' AS activity, 'R01' AS id

# API upstream do Artia
# Para usar source=upstream, defina:
# ARTIA_UPSTREAM_URL=https://seu-endpoint-artia
# ARTIA_API_KEY=sua-chave
# ARTIA_AUTH_HEADER=Authorization
# ARTIA_AUTH_SCHEME=Bearer
# ARTIA_DATA_PATH=data.items
# ARTIA_PROJECT_FIELD=project.id
# ARTIA_PROJECT_LABEL_FIELD=project.name
# ARTIA_WORK_GROUP_FIELD=workGroup
# ARTIA_ACTIVITY_FIELD=name
# ARTIA_ID_FIELD=id

# Vercel Blob
# Se BLOB_READ_WRITE_TOKEN existir na Vercel, o snapshot persistido vai para o Blob.
# Sem ele, localmente o refresh grava em .cache/artia-ids.json
# BLOB_READ_WRITE_TOKEN=...
# ARTIA_SNAPSHOT_BLOB_PATH=artia/artia-ids.json
